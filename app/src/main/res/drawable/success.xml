<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Radial Celebration Glow -->
    <path
        android:pathData="M100,15 A85,85 0 1,1 99.9,15 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="85"
                android:startColor="#3510B981"
                android:endColor="#00000000">
                <item android:color="#3510B981" android:offset="0.0"/>
                <item android:color="#00000000" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Success Badge Circle -->
    <path
        android:pathData="M100,30 A70,70 0 1,1 99.9,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="30"
                android:endX="170"
                android:endY="170"
                android:startColor="#FF10B981"
                android:endColor="#FF047857">
                <item android:color="#FF10B981" android:offset="0.0"/>
                <item android:color="#FF047857" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Ring Accent -->
    <path
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="6"
        android:pathData="M100,45 A55,55 0 1,1 99.9,45 Z" />

    <!-- Bold Checkmark -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M70,102 L90,122 L132,78" />

    <!-- Confetti & Floating Stars -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M30,30 L33,37 L40,40 L33,43 L30,50 L27,43 L20,40 L27,37 Z" />
    <path
        android:fillColor="#FBBF24"
        android:pathData="M170,35 L172,40 L177,42 L172,44 L170,49 L168,44 L163,42 L168,40 Z" />
    <path
        android:fillColor="#38BDF8"
        android:pathData="M160,140 L163,146 L169,148 L163,150 L160,156 L157,150 L151,148 L157,146 Z" />
    <path
        android:fillColor="#F43F5E"
        android:pathData="M35,145 L38,151 L44,153 L38,155 L35,161 L32,155 L26,153 L32,151 Z" />
</vector>
