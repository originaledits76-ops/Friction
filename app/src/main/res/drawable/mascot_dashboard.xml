<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Speed Shield Base Glow -->
    <path
        android:pathData="M100,25 L165,55 C165,115 135,160 100,175 C65,160 35,115 35,55 Z"
        android:fillAlpha="0.2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="100"
                android:startY="25"
                android:endX="100"
                android:endY="175">
                <item android:color="#FF00E5FF" android:offset="0.0" />
                <item android:color="#FF7C4DFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Speedometer Gauge Outer Arc -->
    <path
        android:pathData="M50,115 A60,60 0 1,1 150,115"
        android:fillColor="#00000000"
        android:strokeWidth="10"
        android:strokeColor="#1E293B"
        android:strokeLineCap="round" />

    <path
        android:pathData="M50,115 A60,60 0 0,1 135,70"
        android:fillColor="#00000000"
        android:strokeWidth="10"
        android:strokeColor="#FF00E5FF"
        android:strokeLineCap="round" />

    <!-- Robot Mascot Body -->
    <path
        android:pathData="M80,80 C80,65 90,55 100,55 C110,55 120,65 120,80 L120,120 C120,135 110,145 100,145 C90,145 80,135 80,120 Z"
        android:fillColor="#FF0F172A"
        android:strokeWidth="2"
        android:strokeColor="#FF38BDF8" />

    <!-- Visor -->
    <path
        android:pathData="M86,72 L114,72 C118,72 120,75 120,78 L120,92 C120,95 118,98 114,98 L86,98 C82,98 80,95 80,92 L80,78 C80,75 82,72 86,72 Z"
        android:fillColor="#FF0284C7" />

    <!-- Glowing Eyes -->
    <path android:pathData="M 89,85 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0" android:fillColor="#FF00E5FF" />
    <path android:pathData="M 103,85 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0" android:fillColor="#FF00E5FF" />

    <!-- Speed Needle -->
    <path
        android:pathData="M100,115 L130,80"
        android:strokeWidth="4"
        android:strokeColor="#FF7C4DFF"
        android:strokeLineCap="round" />

    <path android:pathData="M 92,115 a 8,8 0 1,0 16,0 a 8,8 0 1,0 -16,0" android:fillColor="#FF38BDF8" />
</vector>
